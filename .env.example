# Variable reference only. The application reads process environment variables;
# it does not automatically load a .env file. Never commit real credentials.
DIGITIZER_SEGMENTATION_ENABLED=false
# baidu is implemented; sam2.1_hiera_tiny is registered but not implemented.
DIGITIZER_SEGMENTATION_BACKEND=baidu
BAIDU_SEGMENTATION_API_KEY=
BAIDU_SEGMENTATION_SECRET_KEY=
DIGITIZER_SEGMENTATION_TIMEOUT_SECONDS=30
# Reserved for a future SAM2 adapter. These do not enable inference today.
SAM2_CHECKPOINT_PATH=
SAM2_DEVICE=auto
