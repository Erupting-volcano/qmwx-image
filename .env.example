# Variable reference only. The application reads process environment variables;
# it does not automatically load a .env file. Never commit real credentials.
DIGITIZER_SEGMENTATION_ENABLED=false
# baidu is implemented; sam2.1_hiera_tiny is registered but not implemented.
DIGITIZER_SEGMENTATION_BACKEND=baidu
BAIDU_SEGMENTATION_API_KEY=
BAIDU_SEGMENTATION_SECRET_KEY=
DIGITIZER_SEGMENTATION_TIMEOUT_SECONDS=30
# Reserved for a future SAM2 adapter. These do not enable inference today.
SAM2_CHECKPOINT_PATH=
SAM2_DEVICE=auto

# Optional VLM analysis. Enabling sends photos/validated observations to the
# configured provider and can incur fees. Confirm region/workspace URL in console.
DIGITIZER_RECOGNITION_ENABLED=false
DIGITIZER_RECOGNITION_COMBINE_TASKS=true
DIGITIZER_RECOGNITION_BACKEND=openai_compatible
DIGITIZER_RECOGNITION_MODEL=qwen3-vl-plus
DIGITIZER_RECOGNITION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DIGITIZER_RECOGNITION_API_KEY=
DIGITIZER_RECOGNITION_TIMEOUT=60
DIGITIZER_RECOGNITION_MAX_IMAGES=10
DIGITIZER_RECOGNITION_MAX_IMAGE_SIDE=1536
DIGITIZER_RECOGNITION_MAX_CONCURRENCY=2
DIGITIZER_RECOGNITION_MIN_INTERVAL=0.25
DIGITIZER_RECOGNITION_MAX_OUTPUT_TOKENS=8192
DIGITIZER_RECOGNITION_TASK_MODELS={}
# Per registered model: api_base/model/api_key_env/timeout. Never inline API keys.
DIGITIZER_RECOGNITION_MODEL_CONFIGS={}
